@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}
<div class="card mx-auto" style="max-width: 36rem">
    <div class="card-body p-4">
        <h1 class="h4">Something went wrong</h1>
        <p>The request could not be completed. If it happened while signing in, check that Keycloak is running
            (<code>docker compose up -d</code>) and try again.</p>
        @if (!string.IsNullOrEmpty(Model.RequestId))
        {
            <p class="text-body-secondary small mb-3">Request ID: <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-primary" asp-page="/Index">Back to the dashboard</a>
    </div>
</div>
