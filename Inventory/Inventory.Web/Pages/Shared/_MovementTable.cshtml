@model IReadOnlyList<MovementModel>
@if (Model.Count == 0)
{
    <div class="empty-state">No movements to show.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Product</th>
                    <th>Type</th>
                    <th class="text-end">Quantity</th>
                    <th class="text-end">Stock after</th>
                    <th>Reason</th>
                </tr>
            </thead>
            <tbody>
                @foreach (MovementModel movement in Model)
                {
                    <tr>
                        <td class="text-nowrap">@DisplayFormat.LocalTime(movement.CreatedAt)</td>
                        <td><a asp-page="/Products/Details" asp-route-id="@movement.ProductId">@movement.ProductSku</a></td>
                        <td>
                            @if (movement.Type == MovementType.In)
                            {
                                <span class="badge text-bg-success">In</span>
                            }
                            else
                            {
                                <span class="badge text-bg-warning">Out</span>
                            }
                        </td>
                        <td class="text-end">@(movement.Type == MovementType.In ? "+" : "−")@movement.Quantity</td>
                        <td class="text-end">@(movement.StockAfter?.ToString() ?? "—")</td>
                        <td class="text-body-secondary">@movement.Reason</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
