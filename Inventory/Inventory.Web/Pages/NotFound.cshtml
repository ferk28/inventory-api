@page
@{
    ViewData["Title"] = "Not found";
}
<div class="card mx-auto" style="max-width: 36rem">
    <div class="card-body p-4">
        <h1 class="h4">That record does not exist</h1>
        <p>The product, category or movement you were looking for was not found. It may have been removed, or the
            link is wrong.</p>
        <a class="btn btn-primary" asp-page="/Index">Back to the dashboard</a>
    </div>
</div>
