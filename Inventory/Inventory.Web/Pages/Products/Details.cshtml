@page "{id:int}"
@model Inventory.Web.Pages.Products.DetailsModel
@{
    ProductModel product = Model.Product;
    ViewData["Title"] = product.Name;
    ViewData["Section"] = "Products";
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-page="Index">Products</a></li>
        <li class="breadcrumb-item active" aria-current="page">@product.Sku</li>
    </ol>
</nav>
<div class="page-header">
    <h1>
        @product.Name
        @if (!product.IsActive)
        {
            <span class="badge text-bg-secondary fs-6 align-middle">Inactive</span>
        }
    </h1>
    @if (User.CanWrite() && product.IsActive)
    {
        <div class="d-flex gap-2">
            <a class="btn btn-primary" asp-page="/Movements/Create" asp-route-productId="@product.Id">Register movement</a>
            <a class="btn btn-outline-primary" asp-page="Edit" asp-route-id="@product.Id">Edit</a>
            <a class="btn btn-outline-danger" asp-page="Delete" asp-route-id="@product.Id">Delete</a>
        </div>
    }
</div>
<div class="row g-3 mb-4">
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-body-secondary small">Stock</div>
                <div class="stat-value">@product.Stock</div>
                @if (product.IsActive && product.Stock == 0)
                {
                    <span class="badge text-bg-danger">Out of stock</span>
                }
                else if (product.IsActive && product.Stock <= DisplayFormat.LowStockThreshold)
                {
                    <span class="badge text-bg-warning">Low stock</span>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">SKU</dt>
                    <dd class="col-sm-9"><code>@product.Sku</code></dd>
                    <dt class="col-sm-3">Category</dt>
                    <dd class="col-sm-9">@product.CategoryName</dd>
                    <dt class="col-sm-3">Price</dt>
                    <dd class="col-sm-9">@DisplayFormat.Money(product.Price)</dd>
                    <dt class="col-sm-3">Description</dt>
                    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(product.Description) ? "—" : product.Description)</dd>
                    <dt class="col-sm-3">Created</dt>
                    <dd class="col-sm-9">@DisplayFormat.LocalTime(product.CreatedAt)</dd>
                    <dt class="col-sm-3">Last change</dt>
                    <dd class="col-sm-9 mb-0">@(DisplayFormat.LocalTime(product.UpdatedAt) ?? "—")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
<div class="card">
    <div class="card-body">
        <h2 class="h5 mb-3">Movement history</h2>
        <partial name="_MovementTable" model="Model.Movements.Items" />
        <div class="mt-3">
            <partial name="_Pager" model="Model.Pager" />
        </div>
    </div>
</div>
