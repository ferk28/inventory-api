@model ProductFieldsModel
@* Shared by Create and Edit. On Edit the SKU is shown but cannot change: the API has no
   way to update it, because other systems identify the product by it. *@
<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="Form.Sku" class="form-label"></label>
        @if (Model.SkuIsEditable)
        {
            <input asp-for="Form.Sku" class="form-control" autofocus />
        }
        else
        {
            <input asp-for="Form.Sku" class="form-control-plaintext fw-semibold" readonly />
        }
        <span asp-validation-for="Form.Sku"></span>
    </div>
    <div class="col-md-8">
        <label asp-for="Form.Name" class="form-label"></label>
        <input asp-for="Form.Name" class="form-control" />
        <span asp-validation-for="Form.Name"></span>
    </div>
    <div class="col-12">
        <label asp-for="Form.Description" class="form-label"></label>
        <textarea asp-for="Form.Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Form.Description"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Form.Price" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">$</span>
            <input asp-for="Form.Price" class="form-control" type="number" step="0.01" min="0" />
        </div>
        <span asp-validation-for="Form.Price"></span>
    </div>
    <div class="col-md-8">
        <label asp-for="Form.CategoryId" class="form-label"></label>
        <select asp-for="Form.CategoryId" asp-items="Model.CategoryOptions" class="form-select">
            <option value="">Choose a category…</option>
        </select>
        <span asp-validation-for="Form.CategoryId"></span>
    </div>
</div>
