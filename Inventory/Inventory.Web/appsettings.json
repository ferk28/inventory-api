{
  "Urls": "http://localhost:5090",
  "OpenBrowserOnStart": true,
  "InventoryApi": {
    "BaseUrl": "http://localhost:5080/",
    "TimeoutSeconds": 15
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/inventory",
    "ClientId": "inventory-web",
    "RequireHttpsMetadata": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
