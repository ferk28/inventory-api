{
  "realm": "inventory",
  "enabled": true,
  "displayName": "Inventory",
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "inventory.read", "description": "Read products, categories and movements" },
      { "name": "inventory.write", "description": "Create, update and delete inventory data" }
    ]
  },
  "clients": [
    {
      "clientId": "inventory-api",
      "name": "Inventory API (machine to machine)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${KEYCLOAK_API_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "inventory-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "inventory-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "inventory-swagger",
      "name": "Inventory Swagger UI",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "protocolMappers": [
        {
          "name": "inventory-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "inventory-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "inventory-web",
      "name": "Inventory web UI",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5090/signin-oidc"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5090/signout-callback-oidc"
      },
      "protocolMappers": [
        {
          "name": "inventory-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "inventory-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@inventory.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Inventory",
      "lastName": "Administrator",
      "credentials": [{ "type": "password", "value": "${KEYCLOAK_DEMO_ADMIN_PASSWORD}", "temporary": false }],
      "realmRoles": ["inventory.read", "inventory.write"]
    },
    {
      "username": "reader",
      "email": "reader@inventory.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Inventory",
      "lastName": "Reader",
      "credentials": [{ "type": "password", "value": "${KEYCLOAK_DEMO_READER_PASSWORD}", "temporary": false }],
      "realmRoles": ["inventory.read"]
    },
    {
      "username": "service-account-inventory-api",
      "enabled": true,
      "serviceAccountClientId": "inventory-api",
      "realmRoles": ["inventory.read", "inventory.write"]
    }
  ]
}
