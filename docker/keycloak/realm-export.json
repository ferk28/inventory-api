{
  "realm": "inventory",
  "enabled": true,
  "displayName": "Inventory",
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "inventory.read", "description": "Read products, categories and movements" },
      { "name": "inventory.write", "description": "Create, update and delete inventory data" }
    ]
  },
  "clients": [
    {
      "clientId": "inventory-api",
      "name": "Inventory API (machine to machine)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "inventory-api-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "inventory-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "inventory-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "inventory-swagger",
      "name": "Inventory Swagger UI",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "protocolMappers": [
        {
          "name": "inventory-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "inventory-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@inventory.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Inventory",
      "lastName": "Administrator",
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "realmRoles": ["inventory.read", "inventory.write"]
    },
    {
      "username": "reader",
      "email": "reader@inventory.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Inventory",
      "lastName": "Reader",
      "credentials": [{ "type": "password", "value": "reader", "temporary": false }],
      "realmRoles": ["inventory.read"]
    },
    {
      "username": "service-account-inventory-api",
      "enabled": true,
      "serviceAccountClientId": "inventory-api",
      "realmRoles": ["inventory.read", "inventory.write"]
    }
  ]
}
