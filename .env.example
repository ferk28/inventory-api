# Copy to .env and adjust. Never commit .env.
DB_HOST=localhost
DB_PORT=1433
DB_NAME=InventoryDb
DB_USER=sa
DB_PASSWORD=Your_strong_Passw0rd!

# Keycloak (OAuth2 provider)
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-console-password
KEYCLOAK_AUTHORITY=http://localhost:8080/realms/inventory
KEYCLOAK_AUDIENCE=inventory-api
KEYCLOAK_SWAGGER_CLIENT_ID=inventory-swagger
# Secret of the confidential inventory-api client (client credentials). Generate your own.
KEYCLOAK_API_CLIENT_SECRET=change-me-to-a-long-random-value
# Passwords of the realm's demo users: admin (read + write) and reader (read only)
KEYCLOAK_DEMO_ADMIN_PASSWORD=change-me-admin-password
KEYCLOAK_DEMO_READER_PASSWORD=change-me-reader-password
KEYCLOAK_REQUIRE_HTTPS_METADATA=false

# API
API_PORT=5080

# Front-end (Angular dev server); comma-separated list of browser origins allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200
